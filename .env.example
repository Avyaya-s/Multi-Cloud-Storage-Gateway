# Copy to .env and replace every value. .env is git-ignored; never commit it.

# --- docker compose ---
POSTGRES_USER=sovereign
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sovereignstripe
MINIO_ROOT_USER=sovereign
MINIO_ROOT_PASSWORD=change-me-at-least-8-chars

# --- gateway ---
DATABASE_URL=postgresql+asyncpg://sovereign:change-me@127.0.0.1:5433/sovereignstripe
PROVIDERS_CONFIG=gateway/config/providers.yaml
# Admin passphrase -> Argon2id -> KEK. Losing it makes every file unreadable.
SS_ADMIN_PASSPHRASE=change-me-to-a-long-passphrase
